# Allow only the manifests, runtime source, build config and migrations required by Dockerfile.
**
!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!tsconfig.base.json
!packages/
!packages/*/
!packages/*/package.json
!packages/*/tsconfig*.json
!packages/*/src/
!packages/*/src/**
!apps/
!apps/reference-host/
!apps/reference-host/package.json
!apps/reference-host/tsconfig*.json
!apps/reference-host/src/
!apps/reference-host/src/**
!db/
!db/migrate.mjs
!db/migrations/
!db/migrations/*.sql
packages/testkit/src/**
**/*.test.ts
**/*.test-support.ts
**/state/conformance/**
**/node_modules/**
**/dist/**
**/*.tsbuildinfo
**/.env*
**/.aws/**
**/.codex/**
**/.agents/**
**/*.pem
**/*.key
