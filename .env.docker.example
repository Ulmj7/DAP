# Local Docker/Compose only. Generate .env.docker.local with scripts/configure-docker.mjs.
DAP_HOST_PORT=3000
DAP_POSTGRES_PORT=54329
DAP_DOCKER_DATABASE_URL=postgresql://dap_app:dap_app_local_only@postgres:5432/dap
DAP_DOCKER_MIGRATE_DATABASE_URL=postgresql://dap_owner:dap_owner_local_only@postgres:5432/dap
DAP_APP_PASSWORD=dap_app_local_only
DAP_OWNER_PASSWORD=dap_owner_local_only
DAP_GLOBAL_ALLOWLIST='["getGuidance"]'
DEV_SESSIONS='[]'
