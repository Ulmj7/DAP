# Reference host: local development only. Copy/generated values belong in ignored .env.local.
NODE_ENV=development
DAP_ALLOW_DEV_AUTH=1
PORT=3000
# Public compose development default. Change if your existing database uses other credentials.
DAP_DATABASE_URL=postgresql://dap_app:dap_app_local_only@127.0.0.1:54329/dap
# Explicit opt-in; omitting this setting defaults to [] (deny all actions).
DAP_GLOBAL_ALLOWLIST='["getGuidance"]'
# Populate with the generation command in docs/reference-host.md.
# Each entry: token, userId, tenantId, sessionId, authenticatedAt, validUntil, permissions.
DEV_SESSIONS='[]'
